# Par défaut : moteurs gratuits locaux. Aucun repli vers un fournisseur payant.
SENSEI_PROVIDER=local
# OpenAI facultatif, uniquement avec SENSEI_PROVIDER=openai. Clé côté serveur.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
PORT=8787
# Serveur personnel, écoute locale par défaut. Sur le réseau local : HOST=0.0.0.0.
HOST=127.0.0.1
# Requis pour toutes les requêtes IA, même en local. Choisir une valeur longue.
SENSEI_ACCESS_TOKEN=replace-with-a-long-random-personal-token
# Origines web autorisées, séparées par des virgules.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8787,http://127.0.0.1:8787
# Sur téléphone : URL HTTPS de ton serveur ou adresse LAN en développement.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Voix locale gratuite, après installation facultative du moteur VOICEVOX.
# VOICEVOX_PYTHON=.venv/bin/python
# VOICEVOX_ROOT=.local/voicevox/runtime
