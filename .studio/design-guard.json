{
  "schemaVersion": "studio-design-guard.v1",
  "includes": [
    "."
  ],
  "excludes": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.studio/**",
    "**/.next/**",
    "**/.astro/**",
    "**/.venv/**",
    "**/__pycache__/**",
